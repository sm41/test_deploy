                        &lt;div&gt;🕓 配信終了 : 2026年09月21日(月)22時00分&lt;/div&gt;
                    &lt;/td&gt;
                &lt;/th&gt;
                &lt;th&gt;
                    &lt;td&gt;
                        &lt;div&gt;🗓️ 放送&amp;emsp; : 9月14日(月)放送分&lt;/div&gt;
                        &lt;div&gt;📡 放送局 : カンテレ&lt;/div&gt;
                    &lt;/td&gt;
                &lt;/th&gt;
            &lt;/table&gt;
