    <id>https://tver.jp/episodes/ep0n8ddq2g</id>
    <updated>2026-10-26T21:54:00+09:00</updated>
    <link href="https://tver.jp/episodes/ep0n8ddq2g" />
    <content>        &lt;body&gt;
            &lt;img src="https://image-cdn.tver.jp/images/content/thumbnail/series/xlarge/srkg7092fi.jpg"&gt;
            &lt;hr&gt;
            &lt;div&gt;🎞️ 救命病棟24時
                &lt;a href="https://tver.jp/series/srkg7092fi" target="_blank" rel="noopener noreferrer"&gt;🔗&lt;/a&gt;
            &lt;/div&gt;
            &lt;table&gt;
