                    &lt;/td&gt;
                &lt;/th&gt;
                &lt;th&gt;
                    &lt;td&gt;
                        &lt;div&gt;🗓️ 放送&amp;emsp; : 9月1日(火)放送分&lt;/div&gt;
                        &lt;div&gt;📡 放送局 : MBS&lt;/div&gt;
                    &lt;/td&gt;
