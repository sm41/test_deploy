    <content>        &lt;body&gt;
            &lt;img src="https://image-cdn.tver.jp//images/content/thumbnail/series/xlarge/srkloc6sh2.jpg"&gt;
            &lt;hr&gt;
            &lt;div&gt;
                &lt;details&gt;
                    &lt;summary&gt;
                        🎞️ 時代劇シリーズ　必殺仕切人
                        &lt;a href="https://tver.jp/series/srkloc6sh2" target="_blank" rel="noopener noreferrer"&gt;🔗&lt;/a&gt;
                    &lt;/summary&gt;
                    &lt;p&gt;
                        この世の許せぬ悪を“仕切る”闇の殺し屋たち登場
                    &lt;/p&gt;
                    &lt;hr&gt;
                &lt;/details&gt;
            &lt;/div&gt;
            &lt;table&gt;
                &lt;th&gt;
                    &lt;td&gt;
                        &lt;div&gt;🕘 配信開始 : 2026年11月10日(火)09時00分&lt;/div&gt;
                        &lt;div&gt;🕓 配信終了 : 2026年11月20日(金)08時00分&lt;/div&gt;
                    &lt;/td&gt;
                &lt;/th&gt;
                &lt;th&gt;
                    &lt;td&gt;
