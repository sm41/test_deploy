    <link href="https://tver.jp/episodes/epivrca7f1" />
    <content>        &lt;body&gt;
            &lt;img src="https://image-cdn.tver.jp//images/content/thumbnail/series/xlarge/srkloc6sh2.jpg"&gt;
            &lt;hr&gt;
            &lt;div&gt;
                &lt;details&gt;
                    &lt;summary&gt;
