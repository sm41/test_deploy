    <id>https://tver.jp/episodes/epdleteado</id>
    <updated>2026-10-03T14:30:00+09:00</updated>
    <link href="https://tver.jp/episodes/epdleteado" />
    <content>        &lt;body&gt;
            &lt;img src="https://image-cdn.tver.jp/images/content/thumbnail/series/xlarge/srblisj9z4.jpg"&gt;
            &lt;hr&gt;
            &lt;div&gt;🎞️ 『もうええわ』（第37回ヤングシナリオ大賞）
                &lt;a href="https://tver.jp/series/srblisj9z4" target="_blank" rel="noopener noreferrer"&gt;🔗&lt;/a&gt;
            &lt;/div&gt;
            &lt;table&gt;
