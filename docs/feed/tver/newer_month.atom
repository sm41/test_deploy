    <link href="https://tver.jp/episodes/epu992uofs" />
    <content>        &lt;body&gt;
            &lt;img src="https://image-cdn.tver.jp/images/content/thumbnail/series/xlarge/sr78n2tsiv.jpg"&gt;
            &lt;hr&gt;
            &lt;div&gt;🎞️ 君の好きは無敵
                &lt;a href="https://tver.jp/series/sr78n2tsiv" target="_blank" rel="noopener noreferrer"&gt;🔗&lt;/a&gt;
            &lt;/div&gt;
