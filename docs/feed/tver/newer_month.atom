    <updated>2026-11-09T17:45:00+09:00</updated>
    <link href="https://tver.jp/episodes/epbjde12z9" />
    <content>        &lt;body&gt;
            &lt;img src="https://image-cdn.tver.jp//images/content/thumbnail/series/xlarge/sr5s8yysdm.jpg"&gt;
            &lt;hr&gt;
            &lt;div&gt;
                &lt;details&gt;
