    <content>        &lt;body&gt;
            &lt;img src="https://image-cdn.tver.jp/images/content/thumbnail/series/xlarge/srns83dbgi.jpg"&gt;
            &lt;hr&gt;
            &lt;div&gt;🎞️ ラストノート
                &lt;a href="https://tver.jp/series/srns83dbgi" target="_blank" rel="noopener noreferrer"&gt;🔗&lt;/a&gt;
