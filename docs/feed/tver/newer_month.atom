            &lt;img src="https://image-cdn.tver.jp/images/content/thumbnail/series/xlarge/srqlrrnn7c.jpg"&gt;
            &lt;hr&gt;
            &lt;div&gt;🎞️ 救い、巣喰われ
                &lt;a href="https://tver.jp/series/srqlrrnn7c" target="_blank" rel="noopener noreferrer"&gt;🔗&lt;/a&gt;
            &lt;/div&gt;
            &lt;table&gt;
                &lt;th&gt;
                    &lt;td&gt;
                        &lt;div&gt;🕘 配信開始 : 2026年11月01日(日)00時00分&lt;/div&gt;
                        &lt;div&gt;🕓 配信終了 : 2026年12月15日(火)23時59分&lt;/div&gt;
                    &lt;/td&gt;
                &lt;/th&gt;
                &lt;th&gt;
                    &lt;td&gt;
                        &lt;div&gt;🗓️ 放送&amp;emsp; : 2月19日(木)放送分&lt;/div&gt;
                        &lt;div&gt;📡 放送局 : MBS&lt;/div&gt;
