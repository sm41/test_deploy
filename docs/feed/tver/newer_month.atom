            &lt;img src="https://image-cdn.tver.jp/images/content/thumbnail/series/xlarge/srgsxhbdcc.jpg"&gt;
            &lt;hr&gt;
            &lt;div&gt;🎞️ ちょっと待とうよ、春虎くん
                &lt;a href="https://tver.jp/series/srgsxhbdcc" target="_blank" rel="noopener noreferrer"&gt;🔗&lt;/a&gt;
            &lt;/div&gt;
            &lt;table&gt;
                &lt;th&gt;
                    &lt;td&gt;
                        &lt;div&gt;🕘 配信開始 : 2026年09月18日(金)02時04分&lt;/div&gt;
                        &lt;div&gt;🕓 配信終了 : 2026年09月25日(金)02時28分&lt;/div&gt;
                    &lt;/td&gt;
                &lt;/th&gt;
                &lt;th&gt;
                    &lt;td&gt;
                        &lt;div&gt;🗓️ 放送&amp;emsp; : 9月17日(木)放送分&lt;/div&gt;
                        &lt;div&gt;📡 放送局 : MBS&lt;/div&gt;
                    &lt;/td&gt;
                &lt;/th&gt;
            &lt;/table&gt;
